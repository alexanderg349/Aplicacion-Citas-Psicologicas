APP_NAME=Consultorio Psicologico API
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-for-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256
DATABASE_URL=sqlite:///./data/consultorio_psicologia.db
CORS_ORIGINS=http://localhost:5173
SEED_DEMO_DATA=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_ATTEMPTS=8
LOCK_MINUTES_AFTER_FAILURES=15
MAX_LOGIN_FAILURES=5
